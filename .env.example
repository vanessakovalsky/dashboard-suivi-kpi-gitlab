# Copier en .env puis adapter. Ne jamais versionner .env.
GITLAB_IMAGE_TAG=18.5.1-ce.0
PROMETHEUS_IMAGE_TAG=v3.5.0
GRAFANA_IMAGE_TAG=12.1.1
GCPE_IMAGE_TAG=v0.5.10

GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

GITLAB_ROOT_PASSWORD=change-me-min-12-chars
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Token GitLab en lecture (read_api) : généré par scripts/create-gitlab-token.sh
GITLAB_TOKEN=
# Chemin du groupe suivi par l'exporter work items (ex. mon-equipe)
GITLAB_GROUP=
EXPORTER_REFRESH_SECONDS=300
EXPORTER_HISTORY_DAYS=30
WORKFLOW_LABEL_PREFIX=workflow::
PROMETHEUS_RETENTION=90d
